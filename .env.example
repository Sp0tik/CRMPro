# CRMPro environment configuration — EXAMPLE ONLY.
# Copy to .env and replace every placeholder with a strong, private value.
# NEVER commit the real .env file.

# --- Security -------------------------------------------------------------
# Generate a strong key, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Token lifetime in minutes (default 12h).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# development | production  (rate limiting is enforced only in production)
ENVIRONMENT=development

# --- Database -------------------------------------------------------------
# Local development (SQLite, zero setup):
DATABASE_URL=sqlite:///./crmpro.db

# PostgreSQL (Docker / production). Example:
# DATABASE_URL=postgresql+psycopg://crmpro:STRONG_PASSWORD@localhost:5432/crmpro

# --- CORS -----------------------------------------------------------------
# Comma-separated origins, or "*" for local development.
BACKEND_CORS_ORIGINS=*

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- PostgreSQL container defaults (used by docker-compose) ---------------
POSTGRES_USER=crmpro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=crmpro
